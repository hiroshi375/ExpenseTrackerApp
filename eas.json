{
    "cli": {
        "version": ">= 18.4.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "APP_VARIANT": "existing",
                "EAS_NO_FROZEN_LOCKFILE": "1"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_VARIANT": "existing",
                "EAS_NO_FROZEN_LOCKFILE": "1"
            }
        },
        "production": {
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "existing",
                "EAS_NO_FROZEN_LOCKFILE": "1"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
